---
// Cevabı vermeden önce açılabilen küçük ipucu. Cevabı söylemez, düşünmeye yön verir.
import { satirIci } from '../lib/satir-ici';
interface Props { metin?: string }
const { metin } = Astro.props;
---
{metin && (
  <details class="ipucu">
    <summary>💡 İpucu</summary>
    <p set:html={satirIci(metin)} />
  </details>
)}
<style>
  .ipucu { margin: 0.3rem 0 0.5rem; font-family: var(--yazi); font-size: 0.95rem; }
  .ipucu summary { cursor: pointer; color: var(--kismen); font-weight: 650; width: fit-content; }
  .ipucu p { margin: 0.4rem 0 0; padding: 0.5rem 0.8rem; background: color-mix(in srgb, var(--kismen) 10%, transparent); border-radius: 9px; }
</style>
