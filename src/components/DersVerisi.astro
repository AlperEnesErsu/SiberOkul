---
// Ders ve kart listesini sayfaya JSON olarak gömer; tarayıcı betikleri `id="ders-listesi"`den okur.
import { dersOzetleri } from '../lib/ders-listesi';
import { kartOzetleri } from '../lib/kart-listesi';
import { getCollection } from 'astro:content';
import { sinavSoruId } from '../lib/sinav';
import { DONEMLER } from '../data/donemler';

const sinavlar = await getCollection('sinavlar');
const sinavSoruIdleri = sinavlar.flatMap((s) => {
  const slug = DONEMLER.find((d) => d.no === s.data.donem)?.slug ?? '';
  return s.data.sorular.map((_, i) => sinavSoruId(slug, i + 1));
});
const veri = { dersler: await dersOzetleri(), donemler: DONEMLER, kartlar: await kartOzetleri(), sinavDonemleri: sinavlar.map((s) => s.data.donem), sinavSoruIdleri };
---
<script type="application/json" id="ders-listesi" set:html={JSON.stringify(veri).replace(/</g, '\\u003c')} />
