---
import '../styles/genel.css';

interface Props {
  baslik: string;
  aciklama?: string;
}

const { baslik, aciklama = 'Sıfırdan DevSecOps mühendisliğine, her gün bir ders.' } = Astro.props;
const kok = import.meta.env.BASE_URL;
const yol = Astro.url.pathname;

const baglantilar = [
  { ad: 'Bugün', href: kok },
  { ad: 'Yolculuk', href: `${kok}yolculuk/` },
  { ad: 'Efsane mi?', href: `${kok}efsaneler/` },
  { ad: 'Atölye', href: `${kok}atolye/` },
  { ad: 'İlerleme', href: `${kok}ilerleme/` },
];

const aktifMi = (href: string) => (href === kok ? yol === kok : yol.startsWith(href));
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={aciklama} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${kok}favicon.svg`} type="image/svg+xml" />
    <title>{baslik === 'SiberOkul' ? baslik : `${baslik} · SiberOkul`}</title>
  </head>
  <body>
    <header class="ust">
      <div class="kap ust-ic">
        <a class="marka" href={kok}><span aria-hidden="true">&gt;_</span> SiberOkul</a>
        <nav aria-label="Ana gezinme">
          <ul>
            {
              baglantilar.map((b) => (
                <li>
                  <a href={b.href} aria-current={aktifMi(b.href) ? 'page' : undefined}>
                    {b.ad}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main class="kap">
      <slot />
    </main>
    <footer class="kap alt soluk">
      SiberOkul · kişisel öğrenme günlüğü ·
      <a href="https://github.com/AlperEnesErsu/SiberOkul">kaynak kod</a>
    </footer>
  </body>
</html>

<style>
  .ust {
    border-bottom: 1px solid var(--cizgi);
    background: var(--yuzey);
  }
  .ust-ic {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    padding-block: 0.7rem;
  }
  .marka {
    font: 700 1.05rem/1 var(--yazi-kod);
    color: var(--metin);
    text-decoration: none;
  }
  .marka span { color: var(--vurgu); }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--metin-soluk);
    text-decoration: none;
    font-size: 0.95rem;
    padding: 0.2rem 0;
  }
  nav a:hover { color: var(--metin); }
  nav a[aria-current='page'] {
    color: var(--metin);
    box-shadow: inset 0 -2px 0 var(--vurgu);
  }
  main { padding-block: 1.2rem 3rem; min-height: 70vh; }
  .alt {
    border-top: 1px solid var(--cizgi);
    padding-block: 1.2rem 2rem;
    font-size: 0.88rem;
  }
</style>
