---
import '../styles/genel.css';

interface Props {
  baslik: string;
  aciklama?: string;
  /** pano: geniş ızgara + sağ panel; okuma: kâğıt düzeni (sayfa kendi sütunlarını kurar). */
  duzen?: 'pano' | 'okuma';
}

const { baslik, aciklama = 'Sıfırdan DevSecOps mühendisliğine, her gün bir oturum.', duzen = 'pano' } = Astro.props;
const kok = import.meta.env.BASE_URL;
const yol = Astro.url.pathname;
const sagVar = Astro.slots.has('sag');

const baglantilar = [
  { ad: 'Bugün', simge: '🏠', href: kok },
  { ad: 'Yolculuk', simge: '🗺️', href: `${kok}yolculuk/` },
  { ad: 'Efsane mi?', simge: '❓', href: `${kok}efsaneler/` },
  { ad: 'Sözlük', simge: '📖', href: `${kok}sozluk/` },
  { ad: 'Atölye', simge: '🛠️', href: `${kok}atolye/` },
  { ad: 'İlerleme', simge: '📈', href: `${kok}ilerleme/` },
];
const aktifMi = (href: string) =>
  href === kok ? yol === kok || yol.startsWith(`${kok}oturum`) : yol.startsWith(href);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={aciklama} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={`${kok}favicon.svg`} type="image/svg+xml" />
    <title>{baslik === 'SiberOkul' ? baslik : `${baslik} · SiberOkul`}</title>
  </head>
  <body class={`duzen-${duzen}`}>
    <a class="atla gizli-ekran" href="#icerik">İçeriğe geç</a>
    <div class="kabuk">
      <aside class="yan" aria-label="Site">
        <a class="marka" href={kok}><span class="marka-simge" aria-hidden="true">&gt;_</span><span>SiberOkul</span></a>
        <nav aria-label="Ana gezinme">
          <ul>
            {
              baglantilar.map((b) => (
                <li>
                  <a href={b.href} aria-current={aktifMi(b.href) ? 'page' : undefined}>
                    <span class="simge" aria-hidden="true">{b.simge}</span>
                    <span class="ad">{b.ad}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <div class={`orta ${sagVar ? 'sagli' : ''}`}>
        <main id="icerik">
          <slot />
        </main>
        {sagVar && <aside class="sag" aria-label="Durum"><slot name="sag" /></aside>}
      </div>
    </div>
    <script>
      // Geri/ileri önbelleğinden (bfcache) dönen sayfa eski ilerlemeyi göstermesin: tazele.
      window.addEventListener('pageshow', (e) => {
        if (e.persisted) location.reload();
      });
    </script>
  </body>
</html>

<style>
  .atla:focus { position: fixed; top: 0.5rem; left: 0.5rem; width: auto; height: auto; clip: auto; z-index: 50; background: var(--yuzey); padding: 0.5rem 1rem; border-radius: 8px; }

  /* Masaüstü: solda sabit gezinme */
  .yan {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--yan-genislik);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 1.4rem 1rem;
    background: var(--yuzey);
    border-right: 1px solid var(--cizgi);
    z-index: 10;
  }
  .marka { display: flex; align-items: center; gap: 0.6rem; font: 800 1.15rem/1 var(--yazi); color: var(--metin); text-decoration: none; padding: 0.3rem 0.6rem; }
  .marka-simge { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 10px; background: var(--birincil); color: var(--birincil-metin); font: 800 0.85rem/1 var(--yazi-kod); }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  nav a {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.65rem 0.8rem;
    border-radius: 11px;
    color: var(--metin-soluk);
    text-decoration: none;
    font-weight: 600;
  }
  nav a:hover { background: var(--yuzey-2); color: var(--metin); }
  nav a[aria-current='page'] { background: var(--birincil-zemin); color: var(--metin); box-shadow: inset 3px 0 0 var(--birincil); }
  .simge { font-size: 1.15rem; width: 1.5rem; text-align: center; }

  .orta { margin-left: var(--yan-genislik); padding: 1.8rem clamp(1.2rem, 3vw, 3rem) 3rem; min-height: 100vh; }
  .orta.sagli { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: 1.8rem; align-items: start; }
  main { min-width: 0; max-width: 72rem; }
  .sag { position: sticky; top: 1.8rem; display: flex; flex-direction: column; gap: 1rem; }

  /* Tablet: gezinme üstte, sağ panel aşağıda */
  @media (max-width: 1279px) {
    .orta.sagli { grid-template-columns: minmax(0, 1fr); }
    .sag { position: static; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  }
  @media (max-width: 1023px) {
    .yan { position: sticky; inset: 0 0 auto 0; width: auto; flex-direction: row; align-items: center; padding: 0.6rem 1rem; border-right: 0; border-bottom: 1px solid var(--cizgi); }
    nav { flex: 1; }
    nav ul { flex-direction: row; flex-wrap: wrap; justify-content: center; }
    nav a { padding: 0.45rem 0.7rem; }
    nav a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--birincil); }
    .orta { margin-left: 0; padding-top: 1.4rem; }
  }
  /* Telefon: alta sabit sekme çubuğu */
  @media (max-width: 767px) {
    .yan { position: static; padding: 0.7rem 1rem; }
    .yan nav {
      position: fixed; inset: auto 0 0 0; z-index: 20;
      background: var(--yuzey); border-top: 1px solid var(--cizgi);
      padding: 0.3rem 0.3rem calc(0.3rem + env(safe-area-inset-bottom, 0px));
    }
    nav ul { flex-wrap: nowrap; justify-content: space-around; gap: 0; }
    nav a { flex-direction: column; gap: 0.1rem; font-size: 0.68rem; padding: 0.35rem 0.4rem; }
    nav a[aria-current='page'] { box-shadow: none; }
    .marka { flex: 1; }
    .orta { padding: 1rem 1rem 6rem; }
  }
</style>
