---
import { getCollection, render } from 'astro:content';
import Temel from '../../layouts/Temel.astro';
import DersVerisi from '../../components/DersVerisi.astro';
import OturumCercevesi from '../../components/OturumCercevesi.astro';
import KartOkundu from '../../components/KartOkundu.astro';
import HukumRozeti from '../../components/HukumRozeti.astro';
import { dersUrl } from '../../lib/ders-listesi';
import { satirIci } from '../../lib/satir-ici';

export async function getStaticPaths() {
  return (await getCollection('efsaneler')).map((e) => ({ params: { slug: e.id }, props: { e } }));
}
const { e } = Astro.props;
const d = e.data;
const { Content } = await render(e);
const dersler = await getCollection('dersler');
const ilgili = d.ilgiliDers ? dersler.find((x) => x.data.kimlik === d.ilgiliDers) : undefined;
---
<Temel baslik={d.iddia} aciklama={d.ozet} duzen="okuma">
  <DersVerisi />
  <div class="okuma-izgara">
  <aside class="okuma-yan"><OturumCercevesi parca="adimlar" /></aside>
  <div class="okuma-ana">
  <article class="okuma"><div class="okuma-metni">
    <p class="etiket">İddia</p>
    <h1>“{d.iddia}”</h1>
    <div class="tahmin" id="tahmin" data-hukum={d.hukum} hidden>
      <p class="tahmin-soru">Sence bu iddia doğru mu? Önce tahmin et:</p>
      <div class="tahmin-dugmeler">
        <button type="button" data-tahmin="dogru">✅ Doğru</button>
        <button type="button" data-tahmin="kismen">⚠ Kısmen</button>
        <button type="button" data-tahmin="yanlis">❌ Yanlış</button>
      </div>
    </div>
    <div id="efsane-cevap">
    <p id="tahmin-sonuc" class="tahmin-sonuc" role="status" hidden></p>
    <p><span class="etiket">Hüküm</span><br /><HukumRozeti hukum={d.hukum} /></p>
    <p class="ozet" set:html={satirIci(d.ozet)} />
    <div class="govde"><Content /></div>
    {d.analoji && (
      <section class="analoji">
        <p class="etiket">Analoji</p>
        <p set:html={satirIci(d.analoji)} />
      </section>
    )}
    <section>
      <h2>Kaynaklar</h2>
      <ul>
        {d.kaynaklar.map((k) => <li><a href={k.url} rel="noopener noreferrer" target="_blank">{k.ad}</a></li>)}
      </ul>
    </section>
    {ilgili && <p>İlgili ders: <a href={dersUrl(ilgili.data.kimlik)}>{ilgili.data.baslik}</a></p>}
    {d.ilgiliDers && !ilgili && <p class="soluk">İlgili ders yakında: {d.ilgiliDers}</p>}
  </div>
  </div>
  <KartOkundu kimlik={`efsane:${e.id}`} />
  </article>
  <OturumCercevesi parca="cubuk" />
  </div>
  </div>
</Temel>
<script>
  // Önce tahmin: JS varsa cevap gizlenir, tahminden sonra açılır. JS yoksa her şey görünür kalır.
  const kutu = document.getElementById('tahmin');
  const cevap = document.getElementById('efsane-cevap');
  if (kutu && cevap) {
    const hukum = kutu.dataset.hukum;
    const ad: Record<string, string> = { dogru: 'Doğru', kismen: 'Kısmen doğru', yanlis: 'Yanlış' };
    kutu.hidden = false;
    cevap.hidden = true;
    kutu.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tahmin]');
      if (!b) return;
      const t = b.dataset.tahmin!;
      const sonuc = document.getElementById('tahmin-sonuc')!;
      sonuc.textContent = t === hukum ? `🎯 Bildin: ${ad[t]}.` : `Senin tahminin: ${ad[t]}. Gerçek hüküm aşağıda.`;
      sonuc.hidden = false;
      kutu.hidden = true;
      cevap.hidden = false;
    });
  }
</script>

<style>
  .tahmin { background: var(--birincil-zemin); border-radius: var(--r-k); padding: 0.8rem 1rem; font-family: var(--yazi); }
  .tahmin-soru { margin: 0 0 0.6rem; font-weight: 650; }
  .tahmin-dugmeler { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tahmin-sonuc { font-family: var(--yazi); font-weight: 700; font-size: 1.05rem; }
  .ozet { font-size: 1.1rem; font-weight: 500; }
  .analoji { border-left: 4px solid var(--vurgu); background: var(--vurgu-zemin); padding: 0.6rem 1rem; border-radius: 0 var(--r) var(--r) 0; margin: 1.4rem 0; }
  .analoji p:last-child { margin-bottom: 0; }
</style>
