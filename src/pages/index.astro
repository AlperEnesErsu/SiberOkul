---
import Temel from '../layouts/Temel.astro';
import DersVerisi from '../components/DersVerisi.astro';
import DurumPaneli from '../components/DurumPaneli.astro';
import { DONEMLER } from '../data/donemler';
import { DONEM_GORSEL } from '../data/donem-gorsel';
import { dersOzetleri } from '../lib/ders-listesi';

const kok = import.meta.env.BASE_URL;
const ilk = (await dersOzetleri())[0];
---

<Temel baslik="SiberOkul">
  <DersVerisi />

  <header class="selam">
    <div>
      <p class="etiket" id="tarih"></p>
      <h1 id="selam-baslik">Bugünün oturumu</h1>
    </div>
    <ul class="istatistik" aria-label="Özet">
      <li class="kart"><span aria-hidden="true">🔥</span><strong id="seri">0</strong><span>hafta seri</span></li>
      <li class="kart"><span aria-hidden="true">📘</span><strong id="biten-ders">0</strong><span>ders bitti</span></li>
    </ul>
  </header>

  <section class="kart kapi" aria-labelledby="kapi-baslik">
    <div class="kapi-ust">
      <p class="etiket" id="kapi-durum">Hazır</p>
      <h2 id="kapi-baslik">{ilk ? `Bugün: ${ilk.baslik}` : 'Henüz ders yok'}</h2>
      <p class="soluk" id="kapi-alt">Tekrar, ders, kısa bir okuma ve özet: hepsi tek akışta.</p>
    </div>
    <ol class="adimlar" id="kapi-adimlar" aria-label="Oturum adımları"></ol>
    <div class="kapi-alt">
      <a class="dugme birincil buyuk" id="kapi-dugme" href={`${kok}oturum/`}>Oturumu başlat →</a>
      <span class="soluk" id="kapi-sure"></span>
    </div>
  </section>

  <section aria-labelledby="bolge-b">
    <div class="bolum-ust">
      <h2 id="bolge-b">Bölgeler</h2>
      <a href={`${kok}yolculuk/`}>Haritayı aç →</a>
    </div>
    <ul class="bolgeler">
      {
        DONEMLER.map((d) => (
          <li class="kart bolge" data-donem={d.no} style={`--renk:${DONEM_GORSEL[d.no].renk}`}>
            <span class="bolge-simge" aria-hidden="true">{DONEM_GORSEL[d.no].simge}</span>
            <span class="bolge-ad">{d.ad}</span>
            <span class="cubuk" aria-hidden="true"><span class="dolu"></span></span>
            <span class="bolge-sayi soluk">0/{d.planlananDers}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <DurumPaneli slot="sag" />
</Temel>

<script>
  import '../scripts/bugun.ts';
</script>

<style>
  .selam { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem 2rem; margin-bottom: 1.4rem; }
  .selam h1 { margin: 0.2rem 0 0; }
  .istatistik { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .istatistik li { display: grid; grid-template-columns: auto auto; align-items: center; column-gap: 0.5rem; padding: 0.6rem 0.95rem; }
  .istatistik li > span:first-child { grid-row: span 2; font-size: 1.5rem; }
  .istatistik strong { font-size: 1.25rem; line-height: 1.1; }
  .istatistik li > span:not(:first-child) { font-size: 0.8rem; color: var(--metin-soluk); }

  .kapi {
    padding: clamp(1.3rem, 3vw, 2.2rem);
    border: 2px solid var(--birincil);
    background:
      radial-gradient(120% 140% at 100% 0%, var(--birincil-zemin) 0%, transparent 55%),
      var(--yuzey);
  }
  .kapi h2 { font-size: clamp(1.35rem, 2.4vw, 1.9rem); margin: 0.3rem 0 0.3rem; }
  .kapi-ust p { margin: 0; }
  .adimlar { list-style: none; padding: 0; margin: 1.3rem 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .adimlar li {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.45rem 0.8rem; border-radius: 99px;
    background: var(--yuzey-2); font-weight: 600; font-size: 0.92rem;
  }
  .adimlar li.tamam { background: var(--birincil-zemin); }
  .adimlar li.simdi { outline: 2px solid var(--birincil); }
  .kapi-alt { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.2rem; }

  .bolum-ust { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: 2rem; }
  .bolum-ust h2 { margin: 0; }
  .bolgeler { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr)); gap: 0.8rem; }
  .bolge { display: grid; grid-template-columns: auto 1fr; gap: 0.35rem 0.7rem; align-items: center; padding: 0.9rem 1rem; border-top: 4px solid var(--renk); }
  .bolge-simge { grid-row: span 2; font-size: 1.7rem; }
  .bolge-ad { font-weight: 650; font-size: 0.95rem; }
  .bolge .cubuk { grid-column: 1 / -1; }
  .bolge .cubuk > span { background: var(--renk); }
  .bolge-sayi { grid-column: 1 / -1; font: 0.8rem var(--yazi-kod); }
  .bolge.kilitli { opacity: 0.55; }
</style>
